# VoiceTTSr - .gitignore

# Virtual Environments (Bulky)
*-env/
*-env*/
venv/
.venv/

# User Data & Shared Folders (Directories exist, contents ignored)
Output/*
!Output/.gitkeep

references/*
!references/qwen/
!references/xtts/
!references/chatterbox/
references/qwen/*
!references/qwen/.gitkeep
references/xtts/*
!references/xtts/.gitkeep
references/chatterbox/*
!references/chatterbox/.gitkeep

Profiles/*
!Profiles/.gitkeep

# Global Catch for Audio, Profiles & Generated Mod Assets (any folder)
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.safetensors
*.cbprof
*.fuz
*.xwm
*.lip
!docs/assets/**

# Private Assets (Entirely Excluded)
voice_files/
_backup/

# Models & Large Binaries
rvc_models/*.pt
rvc_models/*.pth
rvc_models/*.index
speaker_latents.pt

# In-progress downloads (download_resources.py writes here before verifying
# the SHA-256 hash; a leftover .partial means a download was interrupted
# or failed verification)
*.partial

# Proprietary third-party data that must not be redistributed -- see
# docs/THIRD_PARTY_NOTICES.md. Each user sources their own copy.
tools/FonixData.cdf

# System & OS Files
__pycache__/
*.py[cod]
*$py.class
.DS_Store
Thumbs.db
*.log
*.bak
*.tmp

# Local Runtime Artifacts
voicecloner_config.json
create_shortcut.ps1
.temp_ag_kit/
.agent/

# Agent Protocol Files
CLAUDE.md
MEMORIES.md
KNOWLEDGE.md

# Dev, Documentation & Planning Artifacts
docs/archive/
docs/architecture-design.md
docs/memories.md
docs/project-status.md
docs/project_status.md
docs/Universal_Software_Audit_Prompt.md

# Packaging & Build Artifacts
build/
dist/*
!dist/RELEASE_NOTES.md
*.spec
VoiceTTSr.exe
tools/InnoSetup/
tools/*.exe



